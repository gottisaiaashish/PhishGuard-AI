<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFeedItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#0B1220"
    app:cardCornerRadius="12dp"
    app:strokeColor="#1E293B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Line 1: App Name • Time (Left) & Security Verdict Badge (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFeedAppBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snapchat"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="•"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvFeedTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="2:45 PM"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Security Verdict Badge (Minimalist) -->
            <TextView
                android:id="@+id/tvFeedVerdictBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_safe_border"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="SAFE"
                android:textColor="@color/threat_safe"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Line 2: Sender (Contact / Channel) in Crisp Bold White -->
        <TextView
            android:id="@+id/tvFeedSender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Rajeev anna"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Line 3: Message Body / Content -->
        <TextView
            android:id="@+id/tvFeedMessageSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:text="sent you a Snap"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- Threat Alert Warning (Only visible when isThreat = true) -->
        <LinearLayout
            android:id="@+id/layoutFeedThreatAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1F151B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="7dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/threat_danger" />

            <TextView
                android:id="@+id/tvFeedThreatAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Dangerous phishing link blocked. Do not tap."
                android:textColor="@color/threat_danger"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

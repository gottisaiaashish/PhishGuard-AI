<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/phishguard_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PhishGuard Assistant"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAssistantLangIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online • English"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnClearChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Clear"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Language Selector Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupLanguages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLangEnglish"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="English"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/accent_cyan" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLangTelugu"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="తెలుగు"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/card_stroke" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLangHindi"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="हिंदी"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/card_stroke" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLangTamil"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="தமிழ்"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/card_stroke" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLangKannada"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ಕನ್ನಡ"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/card_stroke" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLangMalayalam"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="മലയാളം"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/card_stroke" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Chat Messages Scroll Area -->
    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/containerChatMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbChatLoading"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp"
        android:indeterminateTint="@color/accent_cyan"
        android:visibility="gone" />

    <!-- Chat Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_box"
            android:hint="Ask about any scam, link, or message..."
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendChat"
            android:layout_width="54dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/accent_cyan"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="➤"
            android:textColor="@color/bg_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

    </LinearLayout>

</LinearLayout>
